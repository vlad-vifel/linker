{
  "name": "linker",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "migrate": "tsx scripts/telegram-to-linker.ts",
    "android:build": "npm run build && cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android:install": "\"%ANDROID_HOME%\\platform-tools\\adb\" install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:start": "\"%ANDROID_HOME%\\platform-tools\\adb\" shell am start -n com.vladv.linker.debug/com.vladv.linker.MainActivity",
    "android": "npm run android:build && npm run android:install && npm run android:start",
    "lint": "eslint \"{src,server,scripts}/**/*.{ts,vue}\" --fix",
    "lint:check": "eslint \"{src,server,scripts}/**/*.{ts,vue}\"",
    "format": "prettier --write \"{src,server,scripts}/**/*.{vue,ts,css}\"",
    "check": "npm run lint:check && npm run build && npm test",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{vue,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
